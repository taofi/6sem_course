<section class="flights-table-section">
  <div class="container">
    <a href="/admin/operator/user"><button>Пользователи</button></a>

    <h2>Список рейсов</h2>

    <% if (flights && flights.length> 0) { %>
      <div class="table-wrapper">
        <table class="flights-table">
          <thead>
            <tr>
              <th data-sort="number">ID рейса</th>
              <th data-sort="text">Маршрут</th>
              <th data-sort="text">Водитель</th>
              <th data-sort="text">Машина</th>
              <th data-sort="number">Цена</th>
              <th data-sort="text">Время отправления</th>
              <th data-sort="text">Время в пути</th>
              <th>Обратный рейс</th>
              <th data-sort="number">Свободно мест</th>
              <th>Действия</th>

              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% flights.forEach(flight=> { %>
              <tr data-id="<%= flight.flight_id %>">
                <td>
                  <%= flight.flight_id %>
                </td>
                <td>
                  <select name="route_id" disabled>
                    <% routes.forEach(route=> { %>
                      <option value="<%= route.route_id %>" <%=route.route_id===flight.route_id ? 'selected' : '' %>>
                        <%= route.startCity %> → <%= route.finishCity %>
                      </option>
                      <% }) %>
                  </select>
                </td>
                <td>
                  <select id="driver_id" name="driver_id" required disabled>
                    <% drivers.forEach(driver=> { %>
                      <option value="<%= driver.user_id %>" <%=driver.user_id===flight.driver_id ? 'selected' : '' %>>
                        <%= driver.name %>
                          <%= driver.last_name %>
                            <%= driver.user_number %>
                      </option>
                      <% }) %>
                  </select>
                </td>

                <td>
                  <select name="car_id" disabled>
                    <% cars.forEach(car=> { %>
                      <option value="<%= car.car_id %>" <%=car.car_id===flight.car_id ? 'selected' : '' %>>
                        <%= car.car_brand %>
                          <%= car.car_number %> (мест: <%= car.capacity %>)
                      </option>
                      <% }) %>
                  </select>
                </td>
                <td><input style="width: 80px;" type="number" value="<%= flight.price %>" disabled></td>
                <td><input type="datetime-local" value="<%= new Date(flight.start_time).toISOString().slice(0, 16) %>"
                    disabled></td>
                <td><input style="width: 80px;" type="text" value="<%= flight.travel_time %>" disabled></td>
                <td>
                  <select name="return_flight" disabled>
                    <option value="false" <%= !flight.return_flight ? 'selected' : '' %>>Прямой</option>
                    <option value="true" <%= flight.return_flight ? 'selected' : '' %>>Oбратный</option>
                  </select>
                  
                </td>
                <td>
                  <%= flight.available_seats %>
                </td>
                <td>
                  <% if (flight.available_seats > 0) { %>
                    <a href="/admin/orderTicket/<%= flight.flight_id %>" class="btn btn-order">Оформить билет</a>
                  <% } else { %>
                    <span>Нет мест</span>
                  <% } %>

                  <a href="/admin/tickets/flight/<%= flight.flight_id %>" class="btn btn-view">Билеты</a>
                </td>
                
              </tr>
              <% }) %>
          </tbody>
        </table>

      </div>
      <% } else { %>
        <p>Рейсы не найдены.</p>
        <% } %>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
       enableTableSorting('.flights-table');
    enableTableSearch('.flights-table');
  });
</script>