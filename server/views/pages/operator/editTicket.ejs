<section class="ticket-order">
  <h2>Оформление билета</h2>

  <div class="flight-info">
    <p><strong>Маршрут:</strong>
      <%= flight.start_city_name %> → <%= flight.finish_city_name %>
    </p>
    <p><strong>Время отправления:</strong>
      <%= new Date(flight.start_time).toLocaleString() %>
    </p>
    <p><strong>Цена:</strong>
      <%= flight.price %>₽
    </p>
    <p><strong>Свободных мест:</strong> <%= flight.capacity %></p>
  </div>

  <form action="/admin/tickets/edit/<%= ticket.ticket_id %>" method="PUT" id="ticketForm">
  

    <div class="form-group">
      <label for="count">Количество билетов:</label>
      <input type="number" name="count" id="count" min="1" required value="<%= ticket?.count || 1 %>">
    </div>

    <div class="form-group">
      <h1>Выберите остановку для посадки</h1>
      <%- include('../../partials/select_part/stops-select.ejs') %>
    </div>

    <input type="hidden" name="stop_id" id="selectedStopId" value="<%= ticket?.stop_id || '' %>">
    <button type="submit" class="btn">Оформить</button>
  </form>
</section>

<script>
  document.getElementById('ticketForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    const form = e.target;
    const count = form.count.value;
    const stop_id = form.stop_id.value;


    if (!stop_id) {
      alert('Пожалуйста, выберите остановку.');
      return;
    }

    try {
      const response = await fetch(form.action, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ count, stop_id })
      });

      if (response.ok) {
        alert('Билет успешно изменен!');
        window.location.href = '/admin/operator';
      } else {
        const text = await response.text();
        alert('Ошибка при изменени: ' + text);
      }
    } catch (err) {
      alert('Произошла ошибка: ' + err.message);
    }
  });

  // Проставляем выбранную остановку, если есть
  window.addEventListener('DOMContentLoaded', () => {
    const selectedId = document.getElementById('selectedStopId').value;
    if (selectedId) {
      const option = document.querySelector(`.custom-select__option[data-id="${selectedId}"]`);
      if (option) {
        option.click();
      }
    }
  });
</script>
