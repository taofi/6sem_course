<section class="user-profile-edit">
  <h2>Редактирование профиля</h2>

  <% if (errors && errors.length > 0) { %>
    <div class="error-messages">
      <ul>
        <% errors.forEach(error => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <% if (success) { %>
    <div class="success-message"><%= success %></div>
  <% } %>

  <form action="/profile/update" method="POST" class="profile-form">
    <div class="form-group">
      <input type="text" name="login" id="login" value="<%= user.login %>" required placeholder=" " />
      <label for="login">Логин</label>
    </div>

    <div class="form-group">
      <input type="text" name="name" id="name" value="<%= user.name %>" required placeholder=" " />
      <label for="name">Имя</label>
    </div>

    <div class="form-group">
      <input type="text" name="last_name" id="last_name" value="<%= user.last_name %>" required placeholder=" " />
      <label for="last_name">Фамилия</label>
    </div>

    <div class="form-group">
      <input type="text" name="user_number" id="user_number" value="<%= user.user_number %>" required placeholder=" " />
      <label for="user_number">Номер телефона</label>
    </div>

    <div class="form-group">
      <input type="password" name="password" id="password" placeholder=" " />
      <label for="password">Новый пароль</label>
    </div>

    <button type="submit">Сохранить изменения</button>
    <a href="/profile" class="btn btn-secondary">Отмена</a>
  </form>
</section>
