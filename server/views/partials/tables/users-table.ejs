<section class="users-table-section">
  <div class="container">
    <h2>Список пользователей</h2>

    <% if (users && users.length > 0) { %>
    <div class="table-wrapper">
      <table class="users-table">
        <thead>
          <tr>
            <th data-sort="number">ID</th>
            <th data-sort="text">Логин</th>
            <th data-sort="text">Роль</th>
            <th data-sort="text">Имя</th>
            <th data-sort="text">Фамилия</th>
            <th>Телефон</th>
            <th>Действия</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr data-id="<%= user.user_id %>">
              <td><%= user.user_id %></td>
              <td><input type="text" value="<%= user.login %>" disabled></td>
              <td>
                <select disabled>
                  <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>Пользователь</option>
                  <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Администратор</option>
                  <option value="operator" <%= user.role === 'operator' ? 'selected' : '' %>>Оператор</option>
                  <option value="driver" <%= user.role === 'driver' ? 'selected' : '' %>>Водитель</option>
                </select>
              </td>
              <td><input type="text" value="<%= user.name %>" disabled></td>
              <td><input type="text" value="<%= user.last_name %>" disabled></td>
              <td><input type="text" value="<%= user.user_number %>" disabled></td>
              <td>
                <button class="edit-btn">Изменить</button>
                <button class="save-btn" style="display:none;">Сохранить</button>
                <button class="cancel-btn" style="display:none;">Отмена</button>
                <button class="delete-btn">Удалить</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <p>Пользователи не найдены.</p>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Удаление пользователя
    document.querySelectorAll('.delete-btn').forEach(button => {
      button.addEventListener('click', async (e) => {
        const row = e.target.closest('tr');
        const userId = row.dataset.id;
        if (!confirm(`Вы уверены, что хотите удалить пользователя с ID ${userId}?`)) return;

        const res = await fetch('/api/users', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: userId })
        });

        if (res.ok) row.remove();
        else alert('Ошибка при удалении');
      });
    });

    // Редактирование пользователя
    document.querySelectorAll('.edit-btn').forEach(button => {
      button.addEventListener('click', (e) => {
        const row = e.target.closest('tr');
        const inputs = row.querySelectorAll('select, input');
        inputs.forEach(input => input.disabled = false);

        row.dataset.oldValues = JSON.stringify(Array.from(inputs).map(i => i.value));

        row.querySelector('.edit-btn').style.display = 'none';
        row.querySelector('.delete-btn').style.display = 'none';
        row.querySelector('.save-btn').style.display = 'inline-block';
        row.querySelector('.cancel-btn').style.display = 'inline-block';
      });
    });

    // Отмена редактирования
    document.querySelectorAll('.cancel-btn').forEach(button => {
      button.addEventListener('click', (e) => {
        const row = e.target.closest('tr');
        const inputs = row.querySelectorAll('select, input');
        const oldValues = JSON.parse(row.dataset.oldValues);
        inputs.forEach((input, i) => {
          input.value = oldValues[i];
          input.disabled = true;
        });

        row.querySelector('.edit-btn').style.display = 'inline-block';
        row.querySelector('.delete-btn').style.display = 'inline-block';
        row.querySelector('.save-btn').style.display = 'none';
        row.querySelector('.cancel-btn').style.display = 'none';
      });
    });

    // Сохранение пользователя
    document.querySelectorAll('.save-btn').forEach(button => {
      button.addEventListener('click', async (e) => {
        const row = e.target.closest('tr');
        const userId = row.dataset.id;
        const [loginInput, roleSelect, nameInput, lastNameInput, phoneInput] = row.querySelectorAll('select, input');

        const data = {
          user_id: parseInt(userId),
          login: loginInput.value,
          role: roleSelect.value,
          name: nameInput.value,
          last_name: lastNameInput.value,
          user_number: phoneInput.value
        };

        const res = await fetch('/api/users', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          [loginInput, roleSelect, nameInput, lastNameInput, phoneInput].forEach(i => i.disabled = true);
          row.querySelector('.edit-btn').style.display = 'inline-block';
          row.querySelector('.delete-btn').style.display = 'inline-block';
          row.querySelector('.save-btn').style.display = 'none';
          row.querySelector('.cancel-btn').style.display = 'none';
        } else {
          const error = await res.json();
          alert('Ошибка при сохранении: ' + (error.message || 'Неизвестная ошибка'));
        }
      });
    });

    enableTableSorting('.users-table');
    enableTableSearch('.users-table');
  });
</script>