<section class="stops-table-section">
  <div class="container">
    <h2>Список остановок</h2>

    <% if (stops && stops.length > 0) { %>
      <div class="table-wrapper">
        <table class="stops-table">
          <thead>
            <tr>
              <th data-sort="number">ID остановки</th>
              <th data-sort="text">Город</th>
              <th data-sort="text">Название</th>
              <th>Адрес</th>
              <th>Время</th>
              <th>Широта</th>
              <th>Долгота</th>
              <th>Действия</th>
              <th>Карта</th>

            </tr>
          </thead>
          <tbody>
            <% stops.forEach(stop => { %>
              <tr data-id="<%= stop.stop_id %>" data-latitude="<%= stop.latitude %>" data-longitude="<%= stop.longitude %>">
                <td><%= stop.stop_id %></td>
                <td>
                  <select disabled>
                    <% cities.forEach(city => { %>
                      <option value="<%= city.city_id %>" <%= city.name === stop.city_name ? 'selected' : '' %>><%= city.name %></option>
                    <% }) %>
                  </select>
                </td>
                <td><input type="text" value="<%= stop.name %>" disabled></td>
                <td><input style="width: 150px;" type="text" value="<%= stop.address %>" disabled></td>
                <td><input type="time" step="1" value="<%= stop.time %>" disabled></td>
                <td><input style="width: 80px;" type="number" step="any" value="<%= stop.latitude %>" disabled class="lat-input"></td>
                <td><input style="width: 80px;" type="number" step="any" value="<%= stop.longitude %>" disabled class="lon-input"></td>
                <td>
                  <button class="edit-btn">Изменить</button>
                  <button class="save-btn" style="display:none;">Сохранить</button>
                  <button class="cancel-btn" style="display:none;">Отмена</button>
                  <button class="delete-btn">Удалить</button>
                </td>
                <td> <button style="background: none;" class="info-btn" title="Показать карту">
                  <img src="/pictures/information.png" alt="info" style="width:20px; height:20px;">
                </button></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p>Остановки не найдены.</p>
    <% } %>
  </div>
</section>

<!-- Карта в фиксированном блоке -->
<div id="mapFixed" style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%);
  width: 500px; height: 400px; background:#fff; border:1px solid #000; z-index:10000; box-shadow:0 0 10px rgba(0,0,0,0.5);">
  <button id="closeMapBtn" style="position:absolute; top:5px; right:5px; z-index:10001;">✖</button>
  <div id="mapFixedContainer" style="width:100%; height:100%;"></div>
</div>

<script>
  let mapFixed;
  let placemarkFixed;

  function initFixedMap(lat, lon, address) {
    if (!mapFixed) {
      mapFixed = new ymaps.Map('mapFixedContainer', {
        center: [lat, lon],
        zoom: 14,
        controls: ['zoomControl']
      });

      placemarkFixed = new ymaps.Placemark([lat, lon], {
        balloonContent: address || ''
      });

      mapFixed.geoObjects.add(placemarkFixed);
    } else {
      mapFixed.setCenter([lat, lon], 14);
      placemarkFixed.geometry.setCoordinates([lat, lon]);
      placemarkFixed.properties.set('balloonContent', address || '');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Кнопка "Показать карту"
    document.querySelectorAll('.info-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const row = e.target.closest('tr');
        if (!row) return;

        const lat = parseFloat(row.querySelector('.lat-input').value);
        const lon = parseFloat(row.querySelector('.lon-input').value);
        const address = row.querySelector('input[type="text"][value]').value || '';

        if (isNaN(lat) || isNaN(lon)) {
          alert('Координаты не указаны или указаны неверно');
          return;
        }

        document.getElementById('mapFixed').style.display = 'block';
        initFixedMap(lat, lon, address);
      });
    });

    // Кнопка закрытия карты
    document.getElementById('closeMapBtn').addEventListener('click', () => {
      document.getElementById('mapFixed').style.display = 'none';
    });

    // Удаление остановки
    document.querySelectorAll('.delete-btn').forEach(button => {
      button.addEventListener('click', async (e) => {
        const row = e.target.closest('tr');
        const stopId = row.dataset.id;
        if (!confirm('Удалить остановку?')) return;

        const res = await fetch('/api/stops', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: stopId })
        });

        if (res.ok) row.remove();
        else alert('Ошибка при удалении');
      });
    });

    // Редактирование остановки
    document.querySelectorAll('.edit-btn').forEach(button => {
      button.addEventListener('click', (e) => {
        const row = e.target.closest('tr');
        const inputs = row.querySelectorAll('select, input');
        inputs.forEach(input => input.disabled = false);

        row.dataset.oldValues = JSON.stringify(Array.from(inputs).map(i => i.value));

        row.querySelector('.edit-btn').style.display = 'none';
        row.querySelector('.delete-btn').style.display = 'none';
        row.querySelector('.save-btn').style.display = 'inline-block';
        row.querySelector('.cancel-btn').style.display = 'inline-block';
      });
    });

    // Отмена редактирования
    document.querySelectorAll('.cancel-btn').forEach(button => {
      button.addEventListener('click', (e) => {
        const row = e.target.closest('tr');
        const inputs = row.querySelectorAll('select, input');
        const oldValues = JSON.parse(row.dataset.oldValues);
        inputs.forEach((input, i) => {
          input.value = oldValues[i];
          input.disabled = true;
        });

        row.querySelector('.edit-btn').style.display = 'inline-block';
        row.querySelector('.delete-btn').style.display = 'inline-block';
        row.querySelector('.save-btn').style.display = 'none';
        row.querySelector('.cancel-btn').style.display = 'none';
      });
    });

    // Сохранение остановки
    document.querySelectorAll('.save-btn').forEach(button => {
      button.addEventListener('click', async (e) => {
        const row = e.target.closest('tr');
        const stopId = row.dataset.id;
        const [select, nameInput, addressInput, timeInput, latInput, lonInput] = row.querySelectorAll('select, input');

        const data = {
          stop_id: parseInt(stopId),
          city_id: parseInt(select.value),
          name: nameInput.value,
          address: addressInput.value,
          time: timeInput.value,
          latitude: parseFloat(latInput.value),
          longitude: parseFloat(lonInput.value)
        };

        const res = await fetch('/api/stops', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          [select, nameInput, addressInput, timeInput, latInput, lonInput].forEach(i => i.disabled = true);
          row.querySelector('.edit-btn').style.display = 'inline-block';
          row.querySelector('.delete-btn').style.display = 'inline-block';
          row.querySelector('.save-btn').style.display = 'none';
          row.querySelector('.cancel-btn').style.display = 'none';
        } else {
          const error = await res.json();
          alert('Ошибка при сохранении: ' + (error.message || 'Неизвестная ошибка'));
        }
      });
    });

    enableTableSorting('.stops-table');
    enableTableSearch('.stops-table');
  });
</script>
