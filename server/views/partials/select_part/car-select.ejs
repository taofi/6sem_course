<div class="form-group">
    <label for="car_id">Машина:</label>
    <select id="car_id" name="car_id" required>
      <option value="" disabled selected>Выберите машину</option>
      <% cars.forEach(car => { %>
        <option value="<%= car.car_id %>"><%= car.car_brand %> <%= car.car_number %> (мест: <%= car.capacity %>)</option>
      <% }) %>
    </select>
  </div>
  