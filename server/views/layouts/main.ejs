<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Мой сайт' %> | <%= siteName || 'Сайт' %></title>
    <link rel="stylesheet" href="/css/styles.css">
    <% if (typeof styles !== 'undefined' && Array.isArray(styles)) { %>
        <% styles.forEach(style => { %>
            <link rel="stylesheet" href="/css/<%= style %>.css">
        <% }); %>
    <% } %>
    <script src="https://api-maps.yandex.ru/2.1/?apikey=ab946b88-b066-4bf0-b9f2-7e5a381d7a80&lang=ru_RU" type="text/javascript"></script>

</head>
<body>
    <% if (typeof hideHeader === 'undefined' || !hideHeader) { %>
        <%- include('../partials/header', { user: user }) %>  <!-- передаем user -->
    <% } %>
    
    <main class="main-content">
        <%- body %>
    </main>
    
    <% if (typeof hideFooter === 'undefined' || !hideFooter) { %>
        <%- include('../partials/footer') %>
    <% } %>
    
    <script src="/js/main.js"></script>
    <% if (typeof scripts !== 'undefined' && Array.isArray(scripts)) { %>
        <% scripts.forEach(script => { %>
            <script src="/js/<%= script %>.js"></script>
        <% }); %>
    <% } %>
</body>
</html>
